# Local dev config for server/contact.mjs.
# Copy to .env (gitignored) and fill in SMTP_PASS. Run with:
#   node --env-file=.env server/contact.mjs
# Just sourcing .env and running without the flag also works.

# mailbox.org SMTP login (full mailbox address).
SMTP_USER=you@mailbox.org
SMTP_PASS=

# Identities.
# MAIL_FROM and AUTOREPLY_FROM must be sending identities the SMTP_USER owns
# (real mailboxes/aliases that can authenticate, not forward-only aliases).
# MAIL_TO can be any address that delivers to you — a receive-only alias is fine.
MAIL_FROM=contact@hlink.dev
MAIL_TO=contact@hlink.dev
AUTOREPLY_FROM=josef@hlink.dev

# Optional overrides (defaults shown).
# PORT=8788
# SMTP_HOST=smtp.mailbox.org
# SMTP_PORT=465
